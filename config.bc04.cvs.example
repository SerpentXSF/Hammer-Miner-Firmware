key,type,encoding,value
main,namespace,,

# ─────────────────────────────────────────────────────────────────────────────
# Hammer BC04 provisioning template.
#
#   cp config.bc04.cvs.example config-bc04.cvs
#
# For a BC01, use config.cvs.example instead. The two are kept apart on
# purpose: the only thing separating a working BC01 from one running at 0.996 V
# is a handful of numbers that look plausible on either board, and the vendor
# shipped exactly that mistake. See docs/BOARDS.md.
#
# config*.cvs is gitignored. Never commit one with real credentials: it is
# flashed verbatim into the NVS partition and is readable from any device
# image.
# ─────────────────────────────────────────────────────────────────────────────

hostname,data,string,HammerBC04

# ── REQUIRED: your network ───────────────────────────────────────────────────
# Leave blank to have the miner start its own access point for setup. It
# appears as HAMMER_xxxx on 192.168.4.1.
wifissid,data,string,
wifipass,data,string,

isStaticIP,data,u16,0
staticIP,data,string,192.168.1.100
subnetMask,data,string,255.255.255.0
gateway,data,string,192.168.1.1
dns,data,string,192.168.1.1

# ── Ethernet ─────────────────────────────────────────────────────────────────
# A BC04's W5500 has to be started AFTER the hashboard is powered. One that is
# already running when the core rail steps to 4.8 V stops answering about 70 ms
# later and never recovers -- it keeps its address and passes nothing, so the
# miner looks networked and reaches no pool. The firmware now starts it at the
# right point and Ethernet works: a BC04 hashing at 750 MHz serves its own API
# over it with no errors.
#
# Verified both with WiFi alongside and with WiFi switched off entirely, which
# is what a freshly flashed miner is: 6218 GH/s on Ethernet alone, 50 accepted
# shares, none rejected, no hardware errors.
#
# docs/KNOWN-ISSUES.md has the measurements and the wrong turns.
eth_on,data,u16,1
wifi_on,data,u16,1

# ── REQUIRED: your pool and YOUR OWN payout address ──────────────────────────
# stratumuser must be an address you control. A miner left on a placeholder
# mines for whoever owns that address, not for you.
#
# Give each miner its own worker suffix. Two miners sharing one name report as
# a single worker and their shares merge.
stratumurl,data,string,solo.ckpool.org
stratumport,data,u16,3333
stratumuser,data,string,REPLACE-WITH-YOUR-BTC-ADDRESS.HammerBC04
stratumpass,data,string,x
stratumdiff,data,u64,10000
stratumtls,data,u16,0
stratumcert,data,string,
stratumxnsub,data,u16,0

fbstratumurl,data,string,solo.ckpool.org
fbstratumport,data,u16,3333
fbstratumuser,data,string,REPLACE-WITH-YOUR-BTC-ADDRESS.HammerBC04
fbstratumpass,data,string,x
fbstratumdiff,data,u64,10000
stratumfbtls,data,u16,0
stratumfbcert,data,string,
stratumfbxnsub,data,u16,0

# ── REQUIRED: API password ───────────────────────────────────────────────────
# Gates every HTTP endpoint. Leave blank ONLY on a fully isolated network:
# blank disables authentication, which is how the vendor firmware shipped.
# See docs/AUTH.md.
apipassword,data,string,

# ── Device identity ──────────────────────────────────────────────────────────
devicemodel,data,string,BC04
boardversion,data,string,V05
asicmodel,data,string,BM1370
sn_str,data,string,AL

# ── ASIC tuning ──────────────────────────────────────────────────────────────
# Voltages are hundredths of a volt for FOUR ASIC DOMAINS IN SERIES. 460 is
# 4.60 V across the string, about 1.15 V each -- so the numbers are roughly
# four times a BC01's and mean the same thing. A BC01's 120 applied here is
# 1.20 V across four chips, which is 0.30 V each and will not run.
#
# The firmware clamps the default at 480 (NVSDevice_parse_config) and the
# regulator ceiling is CONFIG_TPS546_VOUT_MAX, 520 for this board.
#
# These are the vendor's own shipped values. Measured on one unit at 640 MHz:
# 460 draws 77.1 W, and a benchmarked 448 draws 71.6 W at 97% of rated
# hashrate. Tune with the Stay Open Hashrate Benchmark rather than by guessing:
# undervolting a BM1370 past its limit costs hashrate at a zero error rate, so
# nothing reports a fault.
asicfrequency,data,u16,750
asicvoltage,data,u16,470
asicnormalf,data,u16,640
asicnormalvol,data,u16,460
asicoverf,data,u16,750
asicovervol,data,u16,470
asicovervdef,data,u16,480
oc_enabled,data,u16,1

# boot_mode picks which pair above is used: 0 normal (asicnormalf/vol),
# 1 over-frequency (asicoverf/vol). 0 is the conservative start.
boot_mode,data,u16,0

# ── Thermal and display ──────────────────────────────────────────────────────
# 1 is upright on a BC04 -- the opposite of a BC01, where it is 0.
flipscreen,data,u16,1
backlight,data,u16,1
# The BC04 fan is an EMC2302, not LEDC PWM.
invertfanpol,data,u16,0
autofanspeed,data,u16,1
fanspeed,data,u16,80
overheat_mode,data,u16,0

# 0 means RUN the self test, not skip it; it sets itself to 1 on passing.
# Worth leaving at 0 for a first flash: it exercises the fan through four PWM
# steps and confirms all four ASICs before the miner tries to mine.
selftest,data,u16,0

# ── Time ─────────────────────────────────────────────────────────────────────
ntp_main,data,string,pool.ntp.org
ntp_backup,data,string,time.cloudflare.com
time_zone,data,string,UTC0

# ── InfluxDB telemetry (off by default) ──────────────────────────────────────
# The vendor shipped this enabled, pointing at a hardcoded private address
# with a plaintext token. Set influx_enable to 1 and fill in your own server
# if you want it.
influx_enable,data,u16,0
influx_url,data,string,
influx_port,data,u16,8086
influx_token,data,string,
influx_bucket,data,string,
influx_org,data,string,
influx_prefix,data,string,mainnet_stats
